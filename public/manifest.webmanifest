{
  "name": "QR Attendance Student",
  "short_name": "QR Attendance",
  "id": "/login?app_mode=student-pwa",
  "start_url": "/login?app_mode=student-pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f5f7fa",
  "theme_color": "#0d6efd",
  "prefer_related_applications": false,
  "description": "Student portal for QR attendance and attendance history.",
  "icons": [
    {
      "src": "/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
